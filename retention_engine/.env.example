# Guava-owned outbound number. Keep the real value only in your local .env.
GUAVA_AGENT_NUMBER=

# Explicitly authorized live-demo recipient. Never commit a real phone number.
DEMO_TARGET_PHONE=

# Optional display name used only for the authorized demo call.
DEMO_FIRST_NAME=Alex

# Optional. Relative paths are resolved from this directory.
RETENTION_DB_PATH=data/retention.sqlite3
